# Flask
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=0
BIND=127.0.0.1
PORT=5000

# Anope RPC
ANOPE_RPC_URL=http://127.0.0.1:8080/jsonrpc
ANOPE_RPC_TOKEN=your-token-from-modules.conf

# Public base URL of THIS panel (no trailing slash) — must match wherever
# it's actually reachable by end users. Anope's mail templates can't read
# this file, so also set a matching "panel.host" define in anope.conf and
# reference it as ${panel.host} in the mail block's registration_message /
# reset_message / emailchange_message — see the README's "Clickable
# confirmation emails" section for the exact snippet. Keep both values in
# sync by hand.
PANEL_URL=http://127.0.0.1:5000

# Network branding
NETWORK_NAME=My IRC Network
NETWORK_URL=https://example.com
# Logo: URL (https://...) or local path (/static/logo.png) — leave empty for text fallback
NETWORK_LOGO=
# Accent color (hex) — drives the active tab underline and button color
NETWORK_COLOR=#1f6feb
