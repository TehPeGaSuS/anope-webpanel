# Flask
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=0
BIND=127.0.0.1
PORT=5000

# Anope RPC
ANOPE_RPC_URL=http://127.0.0.1:8080/jsonrpc
ANOPE_RPC_TOKEN=your-token-from-modules.conf

# Network branding
NETWORK_NAME=My IRC Network
NETWORK_URL=https://example.com
# Logo: URL (https://...) or local path (/static/logo.png) — leave empty for text fallback
NETWORK_LOGO=
# Accent color (hex) — drives the active tab underline and button color
NETWORK_COLOR=#1f6feb
